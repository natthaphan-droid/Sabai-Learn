  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm ci --prefix backend-worker && npm run deploy --prefix backend-worker",
    "deploy:preview": "npm ci --prefix backend-worker && npm run upload --prefix backend-worker",
    "lint": "oxlint",
